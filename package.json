{
  "name": "dsh-fschannel",
  "description": "Feishu/Lark bot bridge for DeepSeek Harness: bind a web-created session to a Feishu chat, messages flow both ways",
  "version": "0.2.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "watch": "node scripts/build-client.mjs --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run lint && npm run typecheck && npm run build && node scripts/run-tests.mjs",
    "prepack": "node scripts/build-client.mjs"
  },
  "dependencies": {
    "@larksuite/channel": "^0.4.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "typescript": "^7.0.2"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cershuang/dsh-fschannel.git"
  },
  "homepage": "https://github.com/cershuang/dsh-fschannel#readme",
  "bugs": {
    "url": "https://github.com/cershuang/dsh-fschannel/issues"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "feishu",
    "lark",
    "cordis",
    "bot",
    "chatops"
  ],
  "author": "CersHuang",
  "license": "MIT"
}
