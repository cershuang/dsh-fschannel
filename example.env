# ============================================================
# dsh-fschannel — 环境变量示例（复制为 .env 后填写真实值）
# ============================================================
#
# 插件读取规则（lib/env.js）：
#   - 每行 KEY=VALUE（标准格式，推荐）或 KEY VALUE（旧格式，兼容）
#   - 键名大小写不敏感，值两端的引号会被剥离
#   - 优先使用 FEISHU_APP_ID / FEISHU_APP_SECRET；
#     未设置时按顺序回退：appid/secrect（旧拼写）→ APP_ID/APP_SECRET
#     → LARK_APP_ID/LARK_APP_SECRET → FEISHU_APP_ID/FEISHU_APP_SECRET
#   - 插件配置中的 appId/appSecret 优先级最高，会覆盖本文件

# ── 必填：飞书开放平台应用凭据（在开发者后台「凭证与基础信息」获取）──
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=your_app_secret_here

# ── 路径配置（本机相关；改为你机器上的实际路径）────────────────────
# 插件仓库根目录（restart-web.ps1 等脚本据此定位；启动 dsh web 时会
# 导出为环境变量，供 cordis.patch.yml 的 !!js 表达式使用）
FSCHANNEL_REPO=/path/to/dsh-fschannel
# .env 文件自身路径（默认取 dsh web 工作目录下的 .env，一般无需设置）
FSCHANNEL_ENV_FILE=/path/to/dsh-fschannel/.env
# 绑定数据文件路径（默认 $DSH_HOME/feishu-bindings.json，一般无需设置）
# FSCHANNEL_BINDINGS_FILE=/path/to/feishu-bindings.json

# ── 可选别名（任选一种即可，优先级见上）──────────────────────────
# APP_ID=cli_xxxxxxxxxxxxxxxxxxxx
# APP_SECRET=your_app_secret_here
# LARK_APP_ID=cli_xxxxxxxxxxxxxxxxxxxx
# LARK_APP_SECRET=your_app_secret_here

# ── 旧格式兼容（不推荐，仅迁移期支持）────────────────────────────
# appid cli_xxxxxxxxxxxxxxxxxxxx
# secrect your_app_secret_here

# ── 可选：DeepSeek 官方 API Key（dsh 凭据服务的项目 .env 回退源）──
# 未在 $DSH_HOME/.credentials.yaml 或环境变量配置时，新会话的模型
# 请求会从这里读取（与飞书插件无关，dsh 核心功能）。
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
